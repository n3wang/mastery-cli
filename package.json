{
	"name": "mastery-cli",
	"description": "Continuous learning for engineers: flashcards, DSA practice and habit hooks, offline and in your terminal",
	"version": "1.0.33",
	"license": "MIT",
	"bin": {
		"mastery": "index.js",
		"mcli": "index.js"
	},
	"author": {
		"name": "n3wang",
		"url": "https://github.com/n3wang"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n3wang/mastery-cli.git"
	},
	"bugs": {
		"url": "https://github.com/n3wang/mastery-cli/issues"
	},
	"homepage": "https://github.com/n3wang/mastery-cli#readme",
	"engines": {
		"node": ">=16"
	},
	"keywords": [
		"cli",
		"flashcards",
		"spaced-repetition",
		"study",
		"dsa",
		"algorithms",
		"leetcode",
		"learning",
		"offline"
	],
	"files": [
		"index.js",
		"src/",
		"content/",
		"README.md",
		"LICENSE",
		"!src/data/",
		"!src/terms_data/img/",
		"!src/features/dsa/user_files/",
		"!src/features/dsa/data/",
		"!src/features/dsa/solutions/md/",
		"!**/*.map",
		"!**/db.json*"
	],
	"scripts": {
		"test": "mocha",
		"tests": "mocha",
		"format": "prettier --write \"./**/*.{js,json}\"",
		"format:check": "prettier --check \"./**/*.{js,json}\"",
		"doc": "jsdoc -c jsdoc.json"
	},
	"dependencies": {
		"chalk": "^4.1.2",
		"copy-paste": "^1.3.0",
		"enquirer": "^2.3.6",
		"execa": "^6.1.0",
		"expr-eval": "^2.0.2",
		"markdown-it": "^13.0.1",
		"markdown-to-json": "^0.5.4",
		"marked": "^4.2.12",
		"marked-terminal": "^5.1.1",
		"meow": "^9.0.0"
	},
	"devDependencies": {
		"mocha": "^10.2.0",
		"prettier": "^3.0.0"
	}
}
