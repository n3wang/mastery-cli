# ---------------------------------------------------------------------------
# Mastery CLI
#
# User data lives in the vault ($MASTERY_HOME, default <OS data dir>/mastery-cli),
# outside this repository. Nothing user-generated should ever need a rule here.
# See devdocs/i003-open-source-preparation-plan.md section 5.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Generated documentation (published to Pages from CI, never committed)
docs/

# Build output
dist/
**/dist/

# Legacy in-repo user state (removed in the vault migration; kept here so a
# pre-migration working copy does not re-commit it)
src/data/user_data/settings.json
src/data/user_data/daily_decks.json
src/data/user_data/review_decks.json
src/data/user_data/temp/
src/data/user_data/data/
