# ---------------------------------------------------------------------------
# Mastery CLI
#
# User data lives in the vault ($MASTERY_HOME, default <OS data dir>/mastery-cli),
# outside this repository. Nothing user-generated should ever need a rule here.
# See devdocs/i003-open-source-preparation-plan.md section 5.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Generated documentation (published to Pages from CI, never committed)
docs/

# Build output
dist/
**/dist/

# Legacy in-package user data. Migrated into the vault
# ($MASTERY_HOME, default <OS data dir>/mastery-cli) and left on disk so it can
# be verified before deleting. Nothing here is tracked any more.
src/data/user_data/
src/features/dsa/data/
src/features/dsa/user_files/
**/db.json
**/db.json.*
current-quiz.md
# StorableReport defaults to a bare relative filename, so it writes ./report into
# whatever directory the CLI was launched from. Fixed when it moves to the vault.
/report

# Logs and databases
*.log
*.sql

# Environment / secrets
.env
.env.*
!.env.example

# Archives
*.7z
*.dmg
*.gz
*.bz2
*.iso
*.jar
*.rar
*.tar
*.zip
*.tgz

# OS generated files
.DS_Store
**/.DS_Store
ehthumbs.db
Icon?
Thumbs.db
._*

# Editors
.idea/
.vscode/
*.un~
*.swp

# Agent / assistant scratch
.claude/
CLAUDE.md
claude.md
