src/data/user_data/terms_modules/**/cache_problems.json
src/extensions/dsa-cli/data/
src/extensions/dsa-cli/user_files/
src/features/dsa/data/
src/features/dsa/user_files/
**/db.json
**/db.json.*
current-quiz.md

