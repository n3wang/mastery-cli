{
	"source": {
		"include": ["src", "index.js"],
		"exclude": [
			"src/data",
			"src/features/dsa/cloze",
			"src/features/dsa/solutions",
			"src/features/dsa/base_code",
			"src/features/dsa/problem-sets"
		],
		"includePattern": ".js$",
		"excludePattern": "(node_modules/|docs/)"
	},
	"plugins": ["plugins/markdown"],
	"templates": {
		"cleverLinks": true,
		"monospaceLinks": true
	},
	"opts": {
		"recurse": true,
		"destination": "./docs/"
	}
}
