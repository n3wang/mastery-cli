{
	"source": {
		"include": [
			"src",
			"index.js"
		],
		"exclude": [
			"src/data",
			"src/extensions/dsa-cli/cloze",
			"src/extensions/dsa-cli/solutions",
			"src/extensions/dsa-cli/base_code",
			"src/extensions/dsa-cli/tests"
		],
		"includePattern": ".js$",
		"excludePattern": "(node_modules/|docs/)"
	},
	"plugins": [
		"plugins/markdown"
	],
	"templates": {
		"cleverLinks": true,
		"monospaceLinks": true
	},
	"opts": {
		"recurse": true,
		"destination": "./docs/"
	}
}
